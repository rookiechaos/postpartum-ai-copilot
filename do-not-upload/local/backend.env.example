# Copy this file to backend.env and fill in real values.
# Path: do-not-upload/local/backend.env
#
# See docs/security/SECURITY_FIXES_2026-10-09.md for payment verification setup.

AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

DATABASE_URL=sqlite:///../do-not-upload/data/postpartum.db
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32

LOG_DIR=../do-not-upload/logs
VECTOR_DB_PATH=../do-not-upload/vector_db

ASYNC_MODE=true
RAG_ENABLED=true

# Actual account IDs granted by the operator; neither emails nor an entrance selection grant access.
# Manages the deployment's public directory only, without access to other users' health data.
INSTITUTION_USER_IDS=""

# Optional payment webhook verification (paid checkout is not implemented).
STRIPE_WEBHOOK_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT=sandbox
