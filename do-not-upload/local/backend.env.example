# Copy this file to backend.env and fill in real values.
# Path: do-not-upload/local/backend.env
#
# See docs/security/SECURITY_FIXES_2026-10-09.md for payment verification setup.

# Family answer provider: openai, claude, gemini, codex, claude_code, agent.
AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here

# Optional isolated Agent providers. These are full /v1/execute endpoints.
# Keep disabled until the separate runner deployment has been validated.
# To use for family AI, set AI_PROVIDER=codex, claude_code or agent and enable below.
# Provider API keys stay in the separate runner, not this application's environment.
AGENT_ENABLED=false
AGENT_CODEX_RUNNER_URL=""
AGENT_CODEX_RUNNER_TOKEN=""
AGENT_CLAUDE_CODE_RUNNER_URL=""
AGENT_CLAUDE_CODE_RUNNER_TOKEN=""
AGENT_CUSTOM_RUNNER_URL=""
AGENT_CUSTOM_RUNNER_TOKEN=""
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_OUTPUT_CHARS=20000

DATABASE_URL=sqlite:///../do-not-upload/data/postpartum.db
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32

# Required for Docker Compose (unused by local SQLite). Generate a unique value
# with openssl rand -hex 32. Leaving it empty makes Compose refuse to start.
# Use a URL-safe value because Compose constructs DATABASE_URL from it.
POSTGRES_PASSWORD=""

LOG_DIR=../do-not-upload/logs
VECTOR_DB_PATH=../do-not-upload/vector_db

ASYNC_MODE=true
RAG_ENABLED=true

# Actual account IDs granted by the operator; neither emails nor an entrance selection grant access.
# Manages the deployment's public directory only, without access to other users' health data.
INSTITUTION_USER_IDS=""
# Separately provision trusted operators for account support and optional agent APIs.
ADMIN_USER_IDS=""

# Optional payment webhook verification (paid checkout is not implemented).
STRIPE_WEBHOOK_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENVIRONMENT=sandbox
