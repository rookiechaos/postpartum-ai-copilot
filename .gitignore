!do-not-upload/local/backend.env.example
do-not-upload/data/*
!do-not-upload/data/.gitkeep
do-not-upload/logs/*
!do-not-upload/logs/.gitkeep
do-not-upload/vector_db/*
!do-not-upload/vector_db/.gitkeep
do-not-upload/private-docs/*
!do-not-upload/private-docs/.gitkeep
do-not-upload/scripts/*
!do-not-upload/scripts/.gitkeep

# Databases and runtime data (also kept under do-not-upload/)
*.db
*.sqlite
*.sqlite3
/vector_db/
*.chroma

